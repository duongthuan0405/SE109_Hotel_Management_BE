# Connect to Supabase via connection pooling (Transaction mode)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Connect to Supabase directly (Session mode - used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

DB_CONNECTION_STRING=testConnectionStringToDB
JWT_SECRET=your_jwt_secret_here
PORT=4000
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Momo Payment Gateway Config
BACKEND_URL=https://your-ngrok-url.ngrok-free.dev
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create

OTP_LENGTH=6
OTP_DURATION_IN_MINUTES=10
FRONTEND_URL=http://localhost:5173
